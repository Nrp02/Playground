# Classic FizzBuzz from 1 to 30, exercising else-if chains and modulo.

let i = 1;
while (i <= 30) {
    if (i % 15 == 0) {
        print "FizzBuzz";
    } else if (i % 3 == 0) {
        print "Fizz";
    } else if (i % 5 == 0) {
        print "Buzz";
    } else {
        print i;
    }
    i = i + 1;
}
